# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
# Per-demo dev HTML entries from `npm run dev` (isolated so concurrent dev
# servers don't clobber a shared index.html).
/.dev
# Scratch at the repo root only: raw sampler output AND overnight runs under
# samples/experiments/ (night runs, wall-walk dumps, teich exports). Curated
# keepers are copied into data/ and demos/, which ARE tracked. Anchored with a
# leading slash so it doesn't also match the tracked demos/flat-samples/samples/.
/samples

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
package-lock.json

# per-demo live exploration folders (symlinks into gitignored samples/)
demos/*/live/

# GitHub Pages build (scripts/build-all.mjs)
dist-pages
demos/*/index.html
demos/__pages
